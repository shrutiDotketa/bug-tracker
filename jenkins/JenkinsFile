pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }

            steps {
                dir('bugtracker-backend') {
                    sh '''
                        export GOCACHE=/tmp/.go-cache
                        mkdir -p $GOCACHE
                        go test -v ./...
                    '''
                }
            }
        }

        stage ('Unit tests - frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh '''
                    npm ci
                    npm test
                    '''
                }
            }
        }
    }
}